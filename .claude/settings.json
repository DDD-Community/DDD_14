{
  "permissions": {
    "ask": [
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Edit(./client/.oxlintrc.json)",
      "Edit(./client/lint-plugins/**)"
    ],
    "deny": [
      "Read(./client/.env.local)",
      "Read(./client/.env.*.local)",
      "Edit(./client/pnpm-lock.yaml)",
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/client/scripts/agent-hooks/session-start.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/client/scripts/agent-hooks/plan-gate.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/client/scripts/agent-hooks/format-edited-file.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/client/scripts/agent-hooks/stop-gate.mjs"
          }
        ]
      }
    ]
  }
}
